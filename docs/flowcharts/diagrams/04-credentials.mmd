flowchart TB
  a(["工作台用户新增 / 编辑平台账号"])
  b["校验平台、长度、账号归属<br/>新增必须填密码 / 已有账号不可换平台"]
  c{"本次填写了新密码？"}
  d["编辑时留空<br/>只更新备注和用户名"]
